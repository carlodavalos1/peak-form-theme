{% render 'pf-md-assets' %}
{%- assign s = section.settings -%}
<style>#shopify-section-{{ section.id }} .pfm { --pf-accent: {{ s.accent }}; } #shopify-section-{{ section.id }} .pfm-jr { background: {{ s.bg }}; }</style>
<div class="pfm pfm-jr">
  <div class="pfm-jr__grid">
    <div class="pfm-jr__left">
      <div class="pfm-jr__logo">{%- if s.image != blank or s.image_asset != blank -%}{% render 'pf-md-img', image: s.image, asset: s.image_asset, width: 1200, alt: 'Woman holding MacuDrops' %}{%- else -%}<img src="{{ 'pf-md-bottle.webp' | asset_url }}" alt="MacuDrops" loading="lazy" width="1024" height="1024" style="width:auto;height:100%;object-fit:contain">{%- endif -%}</div>
      <div class="pfm-jr__eyebrow">{{ s.eyebrow }}</div>
      <h2>{{ s.heading }}</h2>
      {%- if s.text != blank -%}<div class="pfm-jr__txt">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank -%}
        <a class="pfm-pill" href="{{ s.button_link | default: '#pfm-top' }}">{{ s.button_label }}</a>
        {%- if s.note != blank -%}<div class="pfm-guar">{% render 'pf-md-icon', name: 'shield' %}{{ s.note }}</div>{%- endif -%}
      {%- endif -%}
    </div>
    <div class="pfm-jr__tl">
      {%- for b in section.blocks -%}
        <div class="pfm-jr__step" {{ b.shopify_attributes }}>
          <span class="pfm-jr__dot"></span>
          <div class="pfm-jr__wk">{{ b.settings.label }}</div>
          {%- if b.settings.heading != blank -%}<h3>{{ b.settings.heading }}</h3>{%- endif -%}
          <ul class="pfm-chk">
            {%- assign lines = b.settings.points | newline_to_br | split: '<br />' -%}
            {%- for l in lines -%}{%- assign ls = l | strip -%}{%- if ls != blank -%}<li>{% render 'pf-md-icon', name: 'check-circle' %}<span>{{ ls }}</span></li>{%- endif -%}{%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "PF journey timeline",
  "settings": [
    { "type": "color", "id": "accent", "label": "Accent", "default": "#1E2F63" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Image (theme file name)", "info": "Used when no image is picked above." },
    { "type": "text", "id": "eyebrow", "label": "Accent heading", "default": "Your Eye Health" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Journey With MacuDrops" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Start Your Journey" },
    { "type": "url", "id": "button_link", "label": "Button link (empty = scroll to top)" },
    { "type": "text", "id": "note", "label": "Line under button", "default": "60-Day Money-Back Guarantee" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "limit": 6, "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Week 1" },
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "textarea", "id": "points", "label": "Points (one per line)", "default": "Point one\nPoint two" }
    ] }
  ],
  "presets": [ { "name": "PF journey timeline" } ]
}
{% endschema %}
