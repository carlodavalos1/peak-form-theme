{%- comment -%} Peak Form: home page hero banner (Black Friday style). {%- endcomment -%}
{% render 'pf-md-assets' %}
{%- assign s = section.settings -%}
<style>
  #shopify-section-{{ section.id }} .pfh { --h-a: {{ s.bg_a }}; --h-b: {{ s.bg_b }}; --h-gold: {{ s.gold }}; }
  .pfh { padding: 18px 16px 0; }
  .pfh__card { position: relative; max-width: 1320px; margin: 0 auto; border-radius: 18px; overflow: hidden; display: grid; grid-template-columns: 1.05fr 1fr; min-height: 520px;
    background: linear-gradient(100deg, var(--h-a) 0%, var(--h-a) 30%, var(--h-b) 100%); color: #fff; }
  .pfh__ghost { position: absolute; right: -2%; top: 50%; transform: translateY(-50%); font: 800 clamp(120px, 15vw, 230px)/.86 'Plus Jakarta Sans', sans-serif; letter-spacing: -6px; color: rgba(255,255,255,.08); text-align: right; pointer-events: none; white-space: nowrap; }
  .pfh__copy { position: relative; z-index: 2; padding: 56px 24px 48px 64px; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }
  .pfh__rate { display: flex; align-items: center; gap: 8px; font: 500 14px 'Plus Jakarta Sans', sans-serif; margin-bottom: 14px; opacity: .95; }
  .pfh__rate svg { width: 15px; height: 15px; color: var(--h-gold); }
  .pfh__eb { font: 700 13px 'Plus Jakarta Sans', sans-serif; letter-spacing: 3px; text-transform: uppercase; color: var(--h-gold); margin-bottom: 10px; }
  html body .pfh h1.pfh__title { font: 800 clamp(54px, 7vw, 104px)/.92 'Plus Jakarta Sans', sans-serif !important; letter-spacing: -2px; color: #fff !important; margin: 0 0 22px; text-transform: uppercase; }
  .pfh__pill { display: inline-block; background: #fff; color: var(--h-a); border-radius: 999px; padding: 12px 30px; font: 800 clamp(20px, 2.3vw, 30px)/1.1 'Plus Jakarta Sans', sans-serif; letter-spacing: -.5px; margin-bottom: 20px; }
  .pfh__pill em { font-style: normal; color: #D62828; }
  .pfh__txt { font: 400 17px/1.55 'Poppins', sans-serif; max-width: 470px; opacity: .92; margin-bottom: 24px; }
  .pfh__txt p { margin: 0; }
  .pfh__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 58px; padding: 0 38px; border-radius: 10px; background: var(--h-gold); color: #fff; font: 700 17px 'Plus Jakarta Sans', sans-serif; letter-spacing: .5px; text-decoration: none; transition: filter .2s; }
  .pfh__btn:hover { filter: brightness(1.08); }
  .pfh__sm { margin-top: 12px; font: 500 13px 'Plus Jakarta Sans', sans-serif; opacity: .85; display: flex; align-items: center; gap: 6px; }
  .pfh__sm svg { width: 15px; height: 15px; }
  .pfh__media { position: relative; z-index: 1; display: flex; align-items: flex-end; justify-content: center; }
  .pfh__media img { display: block; width: auto; max-width: 100%; height: 100%; max-height: 560px; object-fit: contain; object-position: bottom; }
  .pfh__media::before { content: ''; position: absolute; left: 50%; bottom: 0; width: 80%; aspect-ratio: 1; transform: translate(-50%, 18%); border-radius: 50%; background: radial-gradient(circle, rgba(184,145,58,.38), rgba(184,145,58,0) 65%); }
  .pfh__media img { position: relative; -webkit-mask-image: linear-gradient(to right, transparent 0, #000 4%, #000 90%, transparent 100%); mask-image: linear-gradient(to right, transparent 0, #000 4%, #000 90%, transparent 100%); }
  @media (max-width: 860px) {
    .pfh { padding: 12px 12px 0; }
    .pfh__card { grid-template-columns: 1fr; min-height: 0; background: linear-gradient(180deg, var(--h-a) 0%, var(--h-b) 100%); }
    .pfh__copy { padding: 34px 22px 8px; align-items: center; text-align: center; }
    .pfh__rate { justify-content: center; }
    .pfh__txt { font-size: 15px; margin-bottom: 18px; }
    .pfh__btn { width: 100%; }
    .pfh__sm { justify-content: center; }
    .pfh__media img { max-height: 360px; }
    .pfh__ghost { top: auto; bottom: 4%; transform: none; right: 50%; transform: translateX(50%); font-size: 96px; letter-spacing: -3px; }
  }
</style>
<div class="pfm pfh">
  <div class="pfh__card">
    {%- if s.ghost != blank -%}<div class="pfh__ghost" aria-hidden="true">{{ s.ghost | newline_to_br }}</div>{%- endif -%}
    <div class="pfh__copy">
      {%- if s.rating_text != blank -%}
        <div class="pfh__rate">{% render 'pf-md-stars' %}<span>{{ s.rating_text }}</span></div>
      {%- endif -%}
      {%- if s.eyebrow != blank -%}<div class="pfh__eb">{{ s.eyebrow }}</div>{%- endif -%}
      <h1 class="pfh__title">{{ s.title | newline_to_br }}</h1>
      {%- if s.pill != blank -%}<div class="pfh__pill">{{ s.pill }}</div>{%- endif -%}
      {%- if s.text != blank -%}<div class="pfh__txt">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank -%}<a class="pfh__btn" href="{{ s.button_link | default: '/collections/all' }}">{{ s.button_label }}</a>{%- endif -%}
      {%- if s.small_text != blank -%}<div class="pfh__sm">{% render 'pf-md-icon', name: 'shield' %}{{ s.small_text }}</div>{%- endif -%}
    </div>
    <div class="pfh__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1100 | image_tag: loading: 'eager', fetchpriority: 'high', alt: s.image.alt }}
      {%- else -%}
        <img src="{{ s.asset | default: 'pf-md-feel-woman.webp' | asset_url }}" alt="Woman holding a bottle of MacuDrops" width="882" height="1100" fetchpriority="high">
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "PF home hero",
  "tag": "section",
  "class": "pf-md-section",
  "settings": [
    { "type": "color", "id": "bg_a", "label": "Background left", "default": "#0B1430" },
    { "type": "color", "id": "bg_b", "label": "Background right", "default": "#34508C" },
    { "type": "color", "id": "gold", "label": "Gold accent", "default": "#B8913A" },
    { "type": "text", "id": "rating_text", "label": "Rating line", "info": "Only add your real rating and review count. Hidden while empty." },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Peak Form MacuDrops" },
    { "type": "textarea", "id": "title", "label": "Big title", "default": "Black\nFriday" },
    { "type": "text", "id": "pill", "label": "White pill", "default": "Up To 60% Off" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>All 3 macular pigments plus 4 supporting nutrients, absorbed under the tongue in 60 seconds a day.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop MacuDrops Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "small_text", "label": "Line under button", "default": "60-Day Money-Back Guarantee" },
    { "type": "textarea", "id": "ghost", "label": "Faded background words", "default": "BLACK\nFRIDAY" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "asset", "label": "Image (theme file name)", "default": "pf-md-feel-woman.webp", "info": "Used when no image is picked. A transparent cutout looks best." }
  ],
  "presets": [ { "name": "PF home hero" } ]
}
{% endschema %}
