{% render 'pf-md-assets' %}
{%- assign s = section.settings -%}
<style>#shopify-section-{{ section.id }} .pfm { --pf-accent: {{ s.accent }}; } #shopify-section-{{ section.id }} .pfm-why { background: {{ s.bg }}; }</style>
<div class="pfm pfm-why">
  <div class="pfm-wrap">
    <h2>{{ s.heading }}</h2>
    {%- if s.sub != blank -%}<p class="pfm-why__sub">{{ s.sub }}</p>{%- endif -%}
    <div class="pfm-why__grid">
      {%- for b in section.blocks -%}
        <div class="pfm-why__card" {{ b.shopify_attributes }}>
          <div class="pfm-why__img">{%- if b.settings.image != blank -%}{{ b.settings.image | image_url: width: 520 | image_tag: loading: 'lazy', alt: b.settings.heading }}{%- else -%}{% render 'pf-md-icon', name: b.settings.icon %}{%- endif -%}</div>
          <div class="pfm-why__body"><h3>{{ b.settings.heading }}</h3><p>{{ b.settings.text }}</p></div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "PF why it works (4 cards)",
  "settings": [
    { "type": "color", "id": "accent", "label": "Accent", "default": "#1E2F63" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why This Formula Actually Works" },
    { "type": "textarea", "id": "sub", "label": "Text" }
  ],
  "blocks": [
    { "type": "card", "name": "Card", "limit": 8, "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "select", "id": "icon", "label": "Icon (when no image)", "options": [{"value": "check-circle", "label": "Check Circle"}, {"value": "shield", "label": "Shield"}, {"value": "truck", "label": "Truck"}, {"value": "refresh", "label": "Refresh"}, {"value": "leaf", "label": "Leaf"}, {"value": "eye", "label": "Eye"}, {"value": "drop", "label": "Drop"}, {"value": "flask", "label": "Flask"}, {"value": "globe", "label": "Globe"}, {"value": "lock", "label": "Lock"}, {"value": "award", "label": "Award"}, {"value": "sun", "label": "Sun"}, {"value": "moon", "label": "Moon"}, {"value": "heart", "label": "Heart"}, {"value": "clock", "label": "Clock"}, {"value": "sparkle", "label": "Sparkle"}, {"value": "monitor", "label": "Monitor"}, {"value": "book", "label": "Book"}, {"value": "car", "label": "Car"}, {"value": "zap", "label": "Zap"}, {"value": "japan", "label": "Japan"}, {"value": "gmp", "label": "Gmp"}, {"value": "calendar", "label": "Calendar"}, {"value": "verified", "label": "Verified"}, {"value": "warning", "label": "Warning"}], "default": "eye" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Text" }
    ] }
  ],
  "presets": [ { "name": "PF why it works (4 cards)" } ]
}
{% endschema %}
