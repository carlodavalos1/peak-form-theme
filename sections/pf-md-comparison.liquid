{% render 'pf-md-assets' %}
{%- assign s = section.settings -%}
<style>#shopify-section-{{ section.id }} .pfm { --pf-accent: {{ s.bg }}; --pf-accent-dark: {{ s.us_bg }}; } #shopify-section-{{ section.id }} .pfm-cmp__list .pfm-ci, #shopify-section-{{ section.id }} .pfm-pill--white { color: {{ s.bg }}; }</style>
<div class="pfm pfm-cmp">
  <div class="pfm-cmp__grid">
    <div class="pfm-cmp__table">
      <div class="pfm-cmp__col pfm-cmp__col--labels">
        <div class="pfm-cmp__hd"></div>
        {%- for b in section.blocks -%}<div class="pfm-cmp__cell" {{ b.shopify_attributes }}>{{ b.settings.label }}</div>{%- endfor -%}
      </div>
      <div class="pfm-cmp__col pfm-cmp__col--us">
        <div class="pfm-cmp__hd">
          {%- if s.us_image != blank -%}{{ s.us_image | image_url: width: 260 | image_tag: loading: 'lazy', alt: s.us_name }}{%- else -%}<img src="{{ 'pf-md-bottle.jpg' | asset_url }}" alt="{{ s.us_name | escape }}" loading="lazy" width="1024" height="1024" style="border-radius:10px">{%- endif -%}
          {{ s.us_name }}
        </div>
        {%- for b in section.blocks -%}<div class="pfm-cmp__cell">{%- if b.settings.us -%}<span class="pfm-cmp__ok">{% render 'pf-md-icon', name: 'check-circle' %}</span>{%- else -%}<span class="pfm-cmp__x">{% render 'pf-md-icon', name: 'x' %}</span>{%- endif -%}</div>{%- endfor -%}
      </div>
      <div class="pfm-cmp__col pfm-cmp__col--them">
        <div class="pfm-cmp__hd">{{ s.them_name }}</div>
        {%- for b in section.blocks -%}<div class="pfm-cmp__cell">{%- if b.settings.them -%}<span class="pfm-cmp__ok" style="color:#3a9b5a">{% render 'pf-md-icon', name: 'check-circle' %}</span>{%- else -%}<span class="pfm-cmp__x">{% render 'pf-md-icon', name: 'x' %}</span>{%- endif -%}</div>{%- endfor -%}
      </div>
    </div>
    <div class="pfm-cmp__copy">
      <h2>{{ s.heading }}</h2>
      {%- assign pts = s.points | newline_to_br | split: '<br />' -%}
      <ul class="pfm-cmp__list">
        {%- for p in pts -%}{%- assign ps = p | strip -%}{%- if ps != blank -%}
          {%- assign parts = ps | split: '|' -%}
          <li><span class="pfm-ci">{% render 'pf-md-icon', name: 'check' %}</span><span>{% if parts.size > 1 %}<b>{{ parts[0] | strip }}</b> {{ parts[1] | strip }}{% else %}{{ ps }}{% endif %}</span></li>
        {%- endif -%}{%- endfor -%}
      </ul>
      {%- if s.button_label != blank -%}
        <div class="pfm-cmp__btn">
          <a class="pfm-pill pfm-pill--white" href="{{ s.button_link | default: '#pfm-top' }}">{{ s.button_label }}</a>
          {%- if s.note != blank -%}<div class="pfm-guar" style="justify-content:flex-start">{% render 'pf-md-icon', name: 'shield' %}{{ s.note }}</div>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "PF comparison table",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#1E2F63" },
    { "type": "color", "id": "us_bg", "label": "Our column", "default": "#0F1B3D" },
    { "type": "text", "id": "us_name", "label": "Our name", "default": "MacuDrops" },
    { "type": "image_picker", "id": "us_image", "label": "Our product image" },
    { "type": "text", "id": "them_name", "label": "Other column", "default": "Typical Capsules" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why MacuDrops Instead of Another Capsule?" },
    { "type": "textarea", "id": "points", "label": "Points (one per line, bold part | rest)", "default": "All 3 pigments: | lutein, zeaxanthin and meso-zeaxanthin." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Try MacuDrops" },
    { "type": "url", "id": "button_link", "label": "Button link (empty = scroll to top)" },
    { "type": "text", "id": "note", "label": "Line under button", "default": "60-Day Money-Back Guarantee" }
  ],
  "blocks": [
    { "type": "row", "name": "Row", "limit": 8, "settings": [
      { "type": "text", "id": "label", "label": "Feature", "default": "Feature" },
      { "type": "checkbox", "id": "us", "label": "We have it", "default": true },
      { "type": "checkbox", "id": "them", "label": "They have it", "default": false }
    ] }
  ],
  "presets": [ { "name": "PF comparison table" } ]
}
{% endschema %}
