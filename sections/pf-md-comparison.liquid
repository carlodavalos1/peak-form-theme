{% render 'pf-md-assets' %}
{%- assign s = section.settings -%}
{%- assign cols = section.blocks | where: 'type', 'column' -%}
{%- assign rows = section.blocks | where: 'type', 'row' -%}
{%- assign ncols = cols.size | plus: 2 -%}
<style>
  #shopify-section-{{ section.id }} .pfm-cmp { background: {{ s.bg }}; }
  #shopify-section-{{ section.id }} .pfm-cmp__copy .pfm-pill { color: {{ s.bg }}; }
  #shopify-section-{{ section.id }} .pfm-ctab { grid-template-columns: 1.35fr repeat({{ ncols | minus: 1 }}, 1fr); }
</style>
{%- capture yes -%}<span class="pfm-cyes" aria-label="Yes"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 12.5l3.6 3.6L17.5 8.7" fill="none" stroke="#fff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{%- endcapture -%}
{%- capture no -%}<span class="pfm-cno" aria-label="No"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8l8 8M16 8l-8 8" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg></span>{%- endcapture -%}
<div class="pfm pfm-cmp">
  <div class="pfm-cmp__grid">
    <div class="pfm-cmp__copy">
      <h2>{{ s.heading }}</h2>
      {%- assign pts = s.points | newline_to_br | split: '<br />' -%}
      <ul class="pfm-cmp__list">
        {%- for p in pts -%}{%- assign ps = p | strip -%}{%- if ps != blank -%}
          {%- assign parts = ps | split: '|' -%}
          <li><span class="pfm-ci">{% render 'pf-md-icon', name: 'check' %}</span><span>{% if parts.size > 1 %}<b>{{ parts[0] | strip }}</b> {{ parts[1] | strip }}{% else %}{{ ps }}{% endif %}</span></li>
        {%- endif -%}{%- endfor -%}
      </ul>
      {%- if s.button_label != blank -%}
        <div class="pfm-cmp__btn">
          <a class="pfm-pill pfm-pill--white" href="{{ s.button_link | default: '#pfm-top' }}">{{ s.button_label }}</a>
          {%- if s.note != blank -%}<div class="pfm-guar">{% render 'pf-md-icon', name: 'shield' %}{{ s.note }}</div>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <div class="pfm-ctab-wrap">
      <div class="pfm-ctab" role="table">
        <div class="pfm-ctab__h pfm-ctab__lbl" role="columnheader"></div>
        <div class="pfm-ctab__h pfm-ctab__us" role="columnheader">
          {% render 'pf-md-img', image: s.us_image, asset: s.us_asset, width: 300, alt: s.us_name, class: 'pfm-ctab__img' %}
          <span>{{ s.us_name }}</span>
        </div>
        {%- for c in cols -%}
          <div class="pfm-ctab__h pfm-ctab__them" role="columnheader" {{ c.shopify_attributes }}>
            {% render 'pf-md-img', image: c.settings.image, asset: c.settings.asset, width: 200, alt: '', class: 'pfm-ctab__img' %}
            <span>{{ c.settings.name }}</span>
          </div>
        {%- endfor -%}
        {%- for r in rows -%}
          {%- assign last = '' -%}{%- if forloop.last -%}{%- assign last = ' is-last' -%}{%- endif -%}
          <div class="pfm-ctab__c pfm-ctab__lbl{{ last }}" role="rowheader" {{ r.shopify_attributes }}>{{ r.settings.label }}</div>
          {%- assign v = r.settings.us | strip | downcase -%}
          <div class="pfm-ctab__c pfm-ctab__us{{ last }}">{% if v == 'yes' %}{{ yes }}{% elsif v == 'no' %}{{ no }}{% else %}<b>{{ r.settings.us }}</b>{% endif %}</div>
          {%- for c in cols -%}
            {%- case forloop.index -%}{%- when 1 -%}{%- assign raw = r.settings.c1 -%}{%- when 2 -%}{%- assign raw = r.settings.c2 -%}{%- else -%}{%- assign raw = r.settings.c3 -%}{%- endcase -%}
            {%- assign v = raw | strip | downcase -%}
            <div class="pfm-ctab__c pfm-ctab__them{{ last }}">{% if v == 'yes' %}{{ yes }}{% elsif v == 'no' %}{{ no }}{% else %}{{ raw }}{% endif %}</div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
      {%- if s.footnote != blank -%}<p class="pfm-cmp__foot">{{ s.footnote }}</p>{%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "PF comparison table",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#1E2F63" },
    { "type": "text", "id": "us_name", "label": "Our name", "default": "MacuDrops" },
    { "type": "image_picker", "id": "us_image", "label": "Our product image (transparent)" },
    { "type": "text", "id": "us_asset", "label": "Our image (theme file name)", "default": "pf-md-bottle.webp" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why MacuDrops Instead of Another Capsule?" },
    { "type": "textarea", "id": "points", "label": "Points (one per line, bold part | rest)" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Try MacuDrops" },
    { "type": "url", "id": "button_link", "label": "Button link (empty = scroll to top)" },
    { "type": "text", "id": "note", "label": "Line under button", "default": "60-Day Money-Back Guarantee" },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "info": "Say where competitor facts come from." }
  ],
  "blocks": [
    { "type": "column", "name": "Competitor column", "limit": 3, "settings": [
      { "type": "text", "id": "name", "label": "Name", "default": "Other brand" },
      { "type": "image_picker", "id": "image", "label": "Image (transparent)" },
      { "type": "text", "id": "asset", "label": "Image (theme file name)", "default": "pf-md-capsules.webp" }
    ] },
    { "type": "row", "name": "Row", "limit": 10, "settings": [
      { "type": "text", "id": "label", "label": "Feature", "default": "Feature" },
      { "type": "text", "id": "us", "label": "Ours (yes, no or text)", "default": "yes" },
      { "type": "text", "id": "c1", "label": "Competitor 1 (yes, no or text)", "default": "no" },
      { "type": "text", "id": "c2", "label": "Competitor 2 (yes, no or text)", "default": "no" },
      { "type": "text", "id": "c3", "label": "Competitor 3 (yes, no or text)", "default": "no" }
    ] }
  ],
  "presets": [ { "name": "PF comparison table" } ]
}
{% endschema %}
