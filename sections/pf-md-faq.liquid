{% render 'pf-md-assets' %}
{%- assign s = section.settings -%}
<style>#shopify-section-{{ section.id }} .pfm-faq { background: {{ s.bg }}; } #shopify-section-{{ section.id }} .pfm-faq details { background: {{ s.item_bg }}; }</style>
<div class="pfm pfm-faq">
  <h2 class="pfm-wrap">{{ s.heading }}</h2>
  <div class="pfm-faq__list">
    {%- for b in section.blocks -%}
      <details {{ b.shopify_attributes }}{% if forloop.first and s.open_first %} open{% endif %}>
        <summary><span>{{ b.settings.q }}</span>{% render 'pf-md-icon', name: 'chevron' %}</summary>
        <div class="pfm-faq__a">{{ b.settings.a }}</div>
      </details>
    {%- endfor -%}
  </div>
  {%- if s.disclaimer != blank -%}<p class="pfm-faq__disc">{{ s.disclaimer }}</p>{%- endif -%}
</div>
{% schema %}
{
  "name": "PF FAQ",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "item_bg", "label": "Question background", "default": "#F7F7F7" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": false },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer" }
  ],
  "blocks": [
    { "type": "q", "name": "Question", "settings": [
      { "type": "text", "id": "q", "label": "Question", "default": "Question" },
      { "type": "richtext", "id": "a", "label": "Answer", "default": "<p>Answer</p>" }
    ] }
  ],
  "presets": [ { "name": "PF FAQ" } ]
}
{% endschema %}
