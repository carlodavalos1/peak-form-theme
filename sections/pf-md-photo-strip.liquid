{% render 'pf-md-assets' %}
{%- assign s = section.settings -%}
<style>#shopify-section-{{ section.id }} .pfm { --pf-accent: {{ s.accent }}; --pf-gold: {{ s.stars }}; --pf-speed: {{ s.speed }}s; } #shopify-section-{{ section.id }} .pfm-strip { background: {{ s.bg }}; }</style>
{%- assign has = false -%}
{%- for b in section.blocks -%}{%- if b.settings.image != blank or b.settings.asset != blank -%}{%- assign has = true -%}{%- endif -%}{%- endfor -%}
{%- if has or request.design_mode -%}
<div class="pfm pfm-strip">
  <div class="pfm-wrap">
    {%- if s.show_stars -%}{% render 'pf-md-stars' %}{%- endif -%}
    <h2>{{ s.heading_a }} <span class="pfm-acc">{{ s.heading_b }}</span>{% if s.heading_c != blank %} {{ s.heading_c }}{% endif %}</h2>
    {%- if s.sub != blank -%}<p class="pfm-strip__sub">{{ s.sub }}</p>{%- endif -%}
  </div>
  <div class="pfm-strip__row">
    {%- for r in (1..2) -%}
      {%- for b in section.blocks -%}
        {%- if b.settings.image != blank or b.settings.asset != blank -%}
          <div{% if r == 1 %} {{ b.shopify_attributes }}{% else %} aria-hidden="true"{% endif %}>{% render 'pf-md-img', image: b.settings.image, asset: b.settings.asset, width: 640, alt: b.settings.alt %}</div>
        {%- elsif request.design_mode and r == 1 -%}
          <div class="pfm-ph" {{ b.shopify_attributes }}>Add a photo</div>
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "PF photo scroller",
  "settings": [
    { "type": "color", "id": "accent", "label": "Accent", "default": "#1E2F63" },
    { "type": "color", "id": "stars", "label": "Stars", "default": "#B8913A" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F3F5FA" },
    { "type": "checkbox", "id": "show_stars", "label": "Show stars", "default": false },
    { "type": "text", "id": "heading_a", "label": "Heading start", "default": "Part of the" },
    { "type": "text", "id": "heading_b", "label": "Heading accent", "default": "Morning Routine" },
    { "type": "text", "id": "heading_c", "label": "Heading end" },
    { "type": "text", "id": "sub", "label": "Text" },
    { "type": "range", "id": "speed", "label": "Seconds per loop", "min": 10, "max": 120, "step": 5, "default": 50 }
  ],
  "blocks": [
    { "type": "photo", "name": "Photo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "asset", "label": "Image (theme file name)", "info": "Used when no image is picked above." },
      { "type": "text", "id": "alt", "label": "Alt text" }
    ] }
  ],
  "presets": [ { "name": "PF photo scroller" } ]
}
{% endschema %}
