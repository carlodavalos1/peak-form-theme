{% render 'pf-md-assets' %}
{%- assign s = section.settings -%}
<style>#shopify-section-{{ section.id }} .pfm { --pf-grad-a: {{ s.grad_a }}; --pf-grad-b: {{ s.grad_b }}; }</style>
<div class="pfm pfm-feel">
  <div class="pfm-wrap">
    <h2>{{ s.heading }}</h2>
    {%- if s.sub != blank -%}<p class="pfm-feel__sub">{{ s.sub }}</p>{%- endif -%}
  </div>
  <div class="pfm-feel__grid">
    <div class="pfm-feel__items">
      {%- for b in section.blocks -%}
        <div class="pfm-feel__item" {{ b.shopify_attributes }}>
          <div class="pfm-feel__ico">{%- if b.settings.image != blank -%}{{ b.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{% render 'pf-md-icon', name: b.settings.icon %}{%- endif -%}</div>
          <h4>{{ b.settings.heading }}</h4>
          {%- if b.settings.text != blank -%}<p>{{ b.settings.text }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="pfm-feel__img">
      {%- if s.image != blank -%}{{ s.image | image_url: width: 920 | image_tag: loading: 'lazy', alt: s.image.alt }}{%- else -%}<img src="{{ 'pf-md-bottle.jpg' | asset_url }}" alt="MacuDrops bottle" loading="lazy" width="1024" height="1024">{%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "PF feel better icons",
  "settings": [
    { "type": "color", "id": "grad_a", "label": "Gradient top", "default": "#2A3F7A" },
    { "type": "color", "id": "grad_b", "label": "Gradient bottom", "default": "#14214A" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Feed Your Eyes. Every Day." },
    { "type": "textarea", "id": "sub", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Product image" }
  ],
  "blocks": [
    { "type": "item", "name": "Icon item", "limit": 6, "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [{"value": "check-circle", "label": "Check Circle"}, {"value": "shield", "label": "Shield"}, {"value": "truck", "label": "Truck"}, {"value": "refresh", "label": "Refresh"}, {"value": "leaf", "label": "Leaf"}, {"value": "eye", "label": "Eye"}, {"value": "drop", "label": "Drop"}, {"value": "flask", "label": "Flask"}, {"value": "globe", "label": "Globe"}, {"value": "lock", "label": "Lock"}, {"value": "award", "label": "Award"}, {"value": "sun", "label": "Sun"}, {"value": "moon", "label": "Moon"}, {"value": "heart", "label": "Heart"}, {"value": "clock", "label": "Clock"}, {"value": "sparkle", "label": "Sparkle"}, {"value": "monitor", "label": "Monitor"}, {"value": "book", "label": "Book"}, {"value": "car", "label": "Car"}, {"value": "zap", "label": "Zap"}, {"value": "japan", "label": "Japan"}, {"value": "gmp", "label": "Gmp"}, {"value": "calendar", "label": "Calendar"}, {"value": "verified", "label": "Verified"}, {"value": "warning", "label": "Warning"}], "default": "eye" },
      { "type": "image_picker", "id": "image", "label": "Custom icon image" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
      { "type": "text", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [ { "name": "PF feel better icons" } ]
}
{% endschema %}
