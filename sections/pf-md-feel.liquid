{% render 'pf-md-assets' %}
{%- assign s = section.settings -%}
{%- assign op = s.overlay_opacity | divided_by: 100.0 -%}
<style>#shopify-section-{{ section.id }} .pfm { --pf-grad-a: {{ s.grad_a }}; --pf-grad-b: {{ s.grad_b }}; --pf-overlay: {{ s.grad_b | color_modify: 'alpha', op }}; --pf-overlay-a: {{ s.grad_a | color_modify: 'alpha', op }}; }</style>
<div class="pfm pfm-feel pfm-feel--{{ s.image_style }}">
  {%- if s.bg_image != blank or s.bg_asset != blank -%}<div class="pfm-feel__bg">{% render 'pf-md-img', image: s.bg_image, asset: s.bg_asset, width: 2400, alt: '' %}</div>{%- endif -%}
  <div class="pfm-wrap">
    <h2>{{ s.heading }}</h2>
    {%- if s.sub != blank -%}<p class="pfm-feel__sub">{{ s.sub }}</p>{%- endif -%}
  </div>
  <div class="pfm-feel__grid">
    <div class="pfm-feel__items">
      {%- for b in section.blocks -%}
        <div class="pfm-feel__item" {{ b.shopify_attributes }}>
          <div class="pfm-feel__ico">{%- if b.settings.image != blank or b.settings.asset != blank -%}{% render 'pf-md-img', image: b.settings.image, asset: b.settings.asset, width: 120, alt: '' %}{%- else -%}{% render 'pf-md-icon', name: b.settings.icon %}{%- endif -%}</div>
          <h4>{{ b.settings.heading }}</h4>
          {%- if b.settings.text != blank -%}<p>{{ b.settings.text }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="pfm-feel__img">
      {%- if s.image != blank or s.image_asset != blank -%}{% render 'pf-md-img', image: s.image, asset: s.image_asset, width: 920, alt: 'MacuDrops' %}{%- else -%}<img src="{{ 'pf-md-bottle.webp' | asset_url }}" alt="MacuDrops bottle" loading="lazy" width="1024" height="1024">{%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "PF feel better icons",
  "settings": [
    { "type": "color", "id": "grad_a", "label": "Gradient top", "default": "#2A3F7A" },
    { "type": "color", "id": "grad_b", "label": "Gradient bottom", "default": "#14214A" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Feed Your Eyes. Every Day." },
    { "type": "textarea", "id": "sub", "label": "Text" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "text", "id": "bg_asset", "label": "Background (theme file name)", "info": "Used when no background is picked above." },
    { "type": "range", "id": "overlay_opacity", "label": "Navy overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 80 },
    { "type": "image_picker", "id": "image", "label": "Main image" },
    { "type": "select", "id": "image_style", "label": "Main image style", "options": [{"value": "photo", "label": "Photo (rounded card)"}, {"value": "person", "label": "Person cutout, sits on bottom edge"}, {"value": "blend", "label": "Blended into background"}, {"value": "cutout", "label": "Transparent bottle"}], "default": "photo" },
    { "type": "text", "id": "image_asset", "label": "Image (theme file name)", "info": "Used when no image is picked above." }
  ],
  "blocks": [
    { "type": "item", "name": "Icon item", "limit": 6, "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [{"value": "check-circle", "label": "Check Circle"}, {"value": "shield", "label": "Shield"}, {"value": "truck", "label": "Truck"}, {"value": "refresh", "label": "Refresh"}, {"value": "leaf", "label": "Leaf"}, {"value": "eye", "label": "Eye"}, {"value": "drop", "label": "Drop"}, {"value": "flask", "label": "Flask"}, {"value": "globe", "label": "Globe"}, {"value": "lock", "label": "Lock"}, {"value": "award", "label": "Award"}, {"value": "sun", "label": "Sun"}, {"value": "moon", "label": "Moon"}, {"value": "heart", "label": "Heart"}, {"value": "clock", "label": "Clock"}, {"value": "sparkle", "label": "Sparkle"}, {"value": "monitor", "label": "Monitor"}, {"value": "book", "label": "Book"}, {"value": "car", "label": "Car"}, {"value": "zap", "label": "Zap"}, {"value": "japan", "label": "Japan"}, {"value": "gmp", "label": "Gmp"}, {"value": "calendar", "label": "Calendar"}, {"value": "verified", "label": "Verified"}, {"value": "warning", "label": "Warning"}, {"value": "dropper", "label": "Dropper"}, {"value": "mouth", "label": "Mouth / tongue"}, {"value": "stethoscope", "label": "Stethoscope"}], "default": "eye" },
      { "type": "image_picker", "id": "image", "label": "Custom icon image" },
      { "type": "text", "id": "asset", "label": "Image (theme file name)", "info": "Used when no image is picked above." },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
      { "type": "text", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [ { "name": "PF feel better icons" } ]
}
{% endschema %}
