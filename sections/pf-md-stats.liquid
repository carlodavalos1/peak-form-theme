{% render 'pf-md-assets' %}
{%- assign s = section.settings -%}
{%- assign op = s.overlay_opacity | divided_by: 100.0 -%}
<style>#shopify-section-{{ section.id }} .pfm { --pf-accent: {{ s.button_text_color }}; --pf-overlay: {{ s.overlay | color_modify: 'alpha', op }}; }</style>
<div class="pfm pfm-stats" style="background: {{ s.overlay }};">
  <div class="pfm-stats__bg">{%- if s.image != blank -%}{{ s.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750, 1200, 1800, 2400', sizes: '100vw', alt: '' }}{%- elsif s.image_asset != blank -%}<img src="{{ s.image_asset | asset_url }}" alt="" loading="lazy" width="1920" height="1080">{%- endif -%}</div>
  <div class="pfm-stats__grid">
    <div class="pfm-stats__nums">
      {%- for b in section.blocks -%}
        <div class="pfm-stat" {{ b.shopify_attributes }}>
          <b data-pfm-count="{{ b.settings.number | escape }}">{{ b.settings.number }}</b>
          <p>{{ b.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
    <div class="pfm-stats__cta">
      <h2>{{ s.heading }}</h2>
      {%- if s.button_label != blank -%}
        <div class="pfm-stats__ctabtn">
          <a class="pfm-pill pfm-pill--white" href="{{ s.button_link | default: '#pfm-top' }}" data-pfm-scrolltop>{{ s.button_label }}</a>
          {%- if s.note != blank -%}<div class="pfm-guar">{% render 'pf-md-icon', name: 'shield' %}{{ s.note }}</div>{%- endif -%}
          {%- if s.footnote != blank -%}<p class="pfm-foot">{{ s.footnote }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "PF stats hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "image_asset", "label": "Image (theme file name)", "info": "Used when no image is picked above." },
    { "type": "color", "id": "overlay", "label": "Overlay color", "default": "#1E2F63" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 85 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Give Your Eyes What They're Built From" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Try MacuDrops Risk-Free" },
    { "type": "url", "id": "button_link", "label": "Button link (empty = scroll to top)" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#1E2F63" },
    { "type": "text", "id": "note", "label": "Line under button", "default": "60-Day Money-Back Guarantee" },
    { "type": "text", "id": "footnote", "label": "Footnote" }
  ],
  "blocks": [
    { "type": "stat", "name": "Stat", "limit": 4, "settings": [
      { "type": "text", "id": "number", "label": "Number", "default": "3", "info": "Use product facts or real survey results only. Numbers animate on scroll." },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Macular pigments in every dropper" }
    ] }
  ],
  "presets": [ { "name": "PF stats hero" } ]
}
{% endschema %}
