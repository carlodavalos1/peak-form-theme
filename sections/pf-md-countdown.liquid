{%- comment -%} Peak Form sale bar with a real countdown to a fixed end time. Hides itself when the time has passed. {%- endcomment -%}
{%- assign s = section.settings -%}
{%- liquid
  assign cd_bg = s.bg
  assign cd_fg = s.color
  assign cd_line = s.top_line
  assign cd_sub = s.sub
  for blk in section.blocks
    assign pg = blk.settings.page | strip | downcase
    if pg != blank
      if pg == template.suffix or pg == template.name or pg == product.handle
        assign cd_bg = blk.settings.bg
        assign cd_fg = blk.settings.color
        assign cd_line = blk.settings.top_line
        if blk.settings.sub != blank
          assign cd_sub = blk.settings.sub
        endif
        break
      endif
    endif
  endfor
-%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
<style>
  .pfm-cd-{{ section.id }} { background: {{ cd_bg }}; color: {{ cd_fg }}; border-top: 6px solid {{ cd_line }}; }
  .pfm-cd { display: block; text-decoration: none; }
  .pfm-cd[hidden] { display: none; }
  .pfm-cd__in { max-width: 1300px; margin: 0 auto; padding: 10px 16px; display: flex; align-items: center; justify-content: center; gap: 44px; }
  .pfm-cd__txt { text-align: right; }
  .pfm-cd__h { font-family: 'Poppins', sans-serif; font-size: 30px; font-weight: 700; letter-spacing: .3px; line-height: 1.1; text-transform: uppercase; margin: 0; color: inherit; }
  .pfm-cd__s { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 18px; font-weight: 400; letter-spacing: .4px; margin-top: 2px; }
  .pfm-cd__t { display: flex; gap: 22px; }
  .pfm-cd__u { text-align: center; min-width: 52px; }
  .pfm-cd__u b { display: block; font-family: 'Poppins', sans-serif; font-size: 34px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
  .pfm-cd__u span { display: block; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 16px; margin-top: 2px; }
  @media (max-width: 749px) {
    .pfm-cd__in { gap: 14px; padding: 8px 10px; justify-content: space-between; }
    .pfm-cd__txt { text-align: left; }
    .pfm-cd__h { font-size: 17px; }
    .pfm-cd__s { font-size: 11.5px; }
    .pfm-cd__t { gap: 8px; }
    .pfm-cd__u { min-width: 30px; }
    .pfm-cd__u b { font-size: 20px; }
    .pfm-cd__u span { font-size: 10px; }
  }
</style>
<a class="pfm-cd pfm-cd-{{ section.id }}" href="{{ s.link | default: '#' }}" data-pfm-cd="{{ s.end | escape }}" hidden>
  <div class="pfm-cd__in">
    <div class="pfm-cd__txt">
      <p class="pfm-cd__h">{{ s.heading }}</p>
      {%- if cd_sub != blank -%}<div class="pfm-cd__s">{{ cd_sub }}</div>{%- endif -%}
    </div>
    <div class="pfm-cd__t" aria-label="Time left">
      <div class="pfm-cd__u"><b data-u="d">00</b><span>{{ s.l_days }}</span></div>
      <div class="pfm-cd__u"><b data-u="h">00</b><span>{{ s.l_hrs }}</span></div>
      <div class="pfm-cd__u"><b data-u="m">00</b><span>{{ s.l_mins }}</span></div>
      <div class="pfm-cd__u"><b data-u="s">00</b><span>{{ s.l_secs }}</span></div>
    </div>
  </div>
</a>
<script>
  (function () {
    var el = document.querySelector('.pfm-cd-{{ section.id }}');
    if (!el) return;
    var end = Date.parse(el.getAttribute('data-pfm-cd'));
    if (isNaN(end)) return;
    var parts = {}; el.querySelectorAll('[data-u]').forEach(function (b) { parts[b.getAttribute('data-u')] = b; });
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    function tick() {
      var left = Math.floor((end - Date.now()) / 1000);
      if (left <= 0) { el.hidden = true; clearInterval(t); return; }
      el.hidden = false;
      parts.d.textContent = pad(Math.floor(left / 86400));
      parts.h.textContent = pad(Math.floor(left % 86400 / 3600));
      parts.m.textContent = pad(Math.floor(left % 3600 / 60));
      parts.s.textContent = pad(left % 60);
    }
    var t = setInterval(tick, 1000); tick();
  })();
</script>
{% schema %}
{
  "name": "PF sale countdown bar",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Black Friday Sale" },
    { "type": "text", "id": "sub", "label": "Text", "default": "Shop Now and Save Sitewide" },
    { "type": "text", "id": "end", "label": "Sale ends (date and time with time zone)", "default": "2026-11-28T00:00:00-05:00", "info": "Format: 2026-11-28T00:00:00-05:00 (that is midnight Eastern at the end of Nov 27). The bar hides itself once this time passes. It never resets." },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#1E2F63" },
    { "type": "color", "id": "color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "top_line", "label": "Top line", "default": "#14254A" },
    { "type": "text", "id": "l_days", "label": "Days label", "default": "Days" },
    { "type": "text", "id": "l_hrs", "label": "Hours label", "default": "Hrs" },
    { "type": "text", "id": "l_mins", "label": "Minutes label", "default": "Mins" },
    { "type": "text", "id": "l_secs", "label": "Seconds label", "default": "Secs" }
  ],
  "blocks": [
    {
      "type": "page_colors",
      "name": "Colors for one page",
      "settings": [
        { "type": "text", "id": "page", "label": "Page", "info": "A product template name (for example heart-ritual or macudrops), a product handle, or index for the home page." },
        { "type": "color", "id": "bg", "label": "Background", "default": "#111111" },
        { "type": "color", "id": "color", "label": "Text", "default": "#FFFFFF" },
        { "type": "color", "id": "top_line", "label": "Top line", "default": "#000000" },
        { "type": "text", "id": "sub", "label": "Text on this page", "info": "Optional. Leave empty to use the main text." }
      ]
    }
  ],
  "presets": [ { "name": "PF sale countdown bar" } ]
}
{% endschema %}
