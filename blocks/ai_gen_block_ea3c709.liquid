{% doc %}
  @prompt
    a automatic sliding carousel block with testimonial images of my customers
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonial-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-testimonial-carousel__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-testimonial-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px;
  }

  .ai-testimonial-carousel__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin: 0;
  }

  .ai-testimonial-carousel__track-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-testimonial-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.slide_gap }}px;
    animation: ai-testimonial-slide-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-testimonial-carousel__track-{{ ai_gen_id }}:hover {
    animation-play-state: paused;
  }

  .ai-testimonial-carousel__slide-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.slide_width }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    box-shadow: 0 4px 12px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
  }

  .ai-testimonial-carousel__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-testimonial-carousel__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonial-carousel__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-testimonial-carousel__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-testimonial-carousel__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-testimonial-carousel__customer-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 8px;
  }

  .ai-testimonial-carousel__rating-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
  }

  .ai-testimonial-carousel__star-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    fill: {{ block.settings.star_color }};
  }

  .ai-testimonial-carousel__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.testimonial_text_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  @keyframes ai-testimonial-slide-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-1 * ({{ block.settings.slide_width }}px + {{ block.settings.slide_gap }}px) * var(--ai-testimonial-slide-count-{{ ai_gen_id }})));
    }
  }

  @media screen and (max-width: 749px) {
    .ai-testimonial-carousel__slide-{{ ai_gen_id }} {
      width: {{ block.settings.slide_width | times: 0.8 }}px;
    }

    .ai-testimonial-carousel__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-testimonial-carousel__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<testimonial-carousel-{{ ai_gen_id }}
  class="ai-testimonial-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.title != blank or block.settings.subtitle != blank %}
    <div class="ai-testimonial-carousel__header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-testimonial-carousel__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-testimonial-carousel__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-testimonial-carousel__track-wrapper-{{ ai_gen_id }}">
    {% liquid
      assign testimonials = ''
      assign testimonial_count = 0

      for i in (1..8)
        assign image_key = 'testimonial_' | append: i | append: '_image'
        assign name_key = 'testimonial_' | append: i | append: '_name'
        assign text_key = 'testimonial_' | append: i | append: '_text'
        assign rating_key = 'testimonial_' | append: i | append: '_rating'

        assign testimonial_image = block.settings[image_key]
        assign testimonial_name = block.settings[name_key]
        assign testimonial_text = block.settings[text_key]
        assign testimonial_rating = block.settings[rating_key]

        if testimonial_image != blank or testimonial_name != blank or testimonial_text != blank
          assign testimonial_count = testimonial_count | plus: 1
        endif
      endfor
    %}

    <div
      class="ai-testimonial-carousel__track-{{ ai_gen_id }}"
      style="--ai-testimonial-slide-count-{{ ai_gen_id }}: {{ testimonial_count }};"
    >
      {% for i in (1..8) %}
        {% liquid
          assign image_key = 'testimonial_' | append: i | append: '_image'
          assign name_key = 'testimonial_' | append: i | append: '_name'
          assign text_key = 'testimonial_' | append: i | append: '_text'
          assign rating_key = 'testimonial_' | append: i | append: '_rating'

          assign testimonial_image = block.settings[image_key]
          assign testimonial_name = block.settings[name_key]
          assign testimonial_text = block.settings[text_key]
          assign testimonial_rating = block.settings[rating_key]
        %}

        {% if testimonial_image != blank or testimonial_name != blank or testimonial_text != blank %}
          <div class="ai-testimonial-carousel__slide-{{ ai_gen_id }}">
            <div class="ai-testimonial-carousel__image-wrapper-{{ ai_gen_id }}">
              {% if testimonial_image %}
                <img
                  src="{{ testimonial_image | image_url: width: 600 }}"
                  alt="{{ testimonial_name | escape }}"
                  class="ai-testimonial-carousel__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="{{ 600 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                >
              {% else %}
                <div class="ai-testimonial-carousel__image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-testimonial-carousel__content-{{ ai_gen_id }}">
              {% if testimonial_name != blank %}
                <h3 class="ai-testimonial-carousel__customer-name-{{ ai_gen_id }}">{{ testimonial_name }}</h3>
              {% endif %}

              {% if testimonial_rating > 0 %}
                <div class="ai-testimonial-carousel__rating-{{ ai_gen_id }}">
                  {% for star in (1..5) %}
                    {% if star <= testimonial_rating %}
                      <svg
                        class="ai-testimonial-carousel__star-{{ ai_gen_id }}"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                      >
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                      </svg>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              {% if testimonial_text != blank %}
                <p class="ai-testimonial-carousel__text-{{ ai_gen_id }}">{{ testimonial_text }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}

      {% for i in (1..8) %}
        {% liquid
          assign image_key = 'testimonial_' | append: i | append: '_image'
          assign name_key = 'testimonial_' | append: i | append: '_name'
          assign text_key = 'testimonial_' | append: i | append: '_text'
          assign rating_key = 'testimonial_' | append: i | append: '_rating'

          assign testimonial_image = block.settings[image_key]
          assign testimonial_name = block.settings[name_key]
          assign testimonial_text = block.settings[text_key]
          assign testimonial_rating = block.settings[rating_key]
        %}

        {% if testimonial_image != blank or testimonial_name != blank or testimonial_text != blank %}
          <div class="ai-testimonial-carousel__slide-{{ ai_gen_id }}">
            <div class="ai-testimonial-carousel__image-wrapper-{{ ai_gen_id }}">
              {% if testimonial_image %}
                <img
                  src="{{ testimonial_image | image_url: width: 600 }}"
                  alt="{{ testimonial_name | escape }}"
                  class="ai-testimonial-carousel__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="{{ 600 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                >
              {% else %}
                <div class="ai-testimonial-carousel__image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-testimonial-carousel__content-{{ ai_gen_id }}">
              {% if testimonial_name != blank %}
                <h3 class="ai-testimonial-carousel__customer-name-{{ ai_gen_id }}">{{ testimonial_name }}</h3>
              {% endif %}

              {% if testimonial_rating > 0 %}
                <div class="ai-testimonial-carousel__rating-{{ ai_gen_id }}">
                  {% for star in (1..5) %}
                    {% if star <= testimonial_rating %}
                      <svg
                        class="ai-testimonial-carousel__star-{{ ai_gen_id }}"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                      >
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                      </svg>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              {% if testimonial_text != blank %}
                <p class="ai-testimonial-carousel__text-{{ ai_gen_id }}">{{ testimonial_text }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</testimonial-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-testimonial-carousel__track-{{ ai_gen_id }}');
        if (this.track) {
          this.setupAccessibility();
        }
      }

      setupAccessibility() {
        this.track.setAttribute('role', 'region');
        this.track.setAttribute('aria-label', 'Customer testimonials carousel');
      }
    }

    customElements.define('testimonial-carousel-{{ ai_gen_id }}', TestimonialCarousel{{ ai_gen_id }});
  })();
</script>

