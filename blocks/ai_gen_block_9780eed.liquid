{% doc %}
  @prompt
    Create a customer reviews section block for a supplement product that helps reduce facial hair growth in women. The block should:
    
    - Display 6 reviews initially, then show additional reviews when "Load More" is clicked
    - Include approximately 50 authentic-sounding customer reviews total, loaded in batches of 6 via a "Load More Reviews" button
    - Reviews should follow a realistic progression timeline: Week 2 - noticing less hair already, Week 4 - growth slowing down, Week 6 - friends and family noticing they're not plucking as much, Week 10 - significant reduction, Week 16 - amazing results it's working
    - Reviews should feel genuine and varied: different names, star ratings mostly 4-5 stars, different writing styles, some short and enthusiastic, some longer and detailed
    - Each review card should show: reviewer name, star rating, date, and review text
    - Include a "Load More Reviews" button that reveals the next batch with a smooth animation
    - Match a clean premium supplement brand aesthetic with neutral white background
    - Fully responsive on mobile, Also, the product is called peakForm, you know? You know? And just, yeah. And also get rid of like the week 2, week 2, week 2, like those green bars, and also make the dates more recent, you know, like, like maybe like, you know, 2025, what is it, like June, you know, not, not even 2024, that's way too like late, you know? Like 2025, you know, going to 2026, yeah, some people 2026, you know? And yeah, make them look more like, you know, authentic, you know? I'm not crazy selling them, but these are kind of good, you know? Yeah. And dont say dates like 2025,08.13. but rather like 1 month ago. 1 week ago. 3 days ago. 4 months ago, 2 weeks ago. You know/
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
    display: block;
  }

  .ai-reviews-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-reviews-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px;
    font-weight: 700;
  }

  .ai-reviews-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    margin: 0;
  }

  .ai-reviews-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
    margin-bottom: 32px;
  }

  .ai-review-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 24px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ai-review-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-review-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
  }

  .ai-review-name-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-review-date-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
  }

  .ai-review-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
  }

  .ai-review-star-{{ ai_gen_id }} {
    width: 18px;
    height: 18px;
    fill: {{ block.settings.star_color }};
  }

  .ai-review-star-empty-{{ ai_gen_id }} {
    fill: #e0e0e0;
  }

  .ai-review-text-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-review-verified-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: {{ block.settings.verified_color }};
    margin-top: 12px;
    font-weight: 500;
  }

  .ai-review-verified-icon-{{ ai_gen_id }} {
    width: 14px;
    height: 14px;
    fill: {{ block.settings.verified_color }};
  }

  .ai-reviews-load-more-{{ ai_gen_id }} {
    text-align: center;
    margin-top: 32px;
  }

  .ai-reviews-button-{{ ai_gen_id }} {
    padding: 14px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .ai-reviews-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    transform: translateY(-2px);
  }

  .ai-reviews-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-review-card-hidden-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .ai-reviews-container-{{ ai_gen_id }} {
      padding: 24px 16px;
    }

    .ai-reviews-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

