    {% for review_data in reviews %}
      {% assign review_parts = review_data | split: '|' %}
      {% assign name = review_parts[0] %}
      {% assign rating = review_parts[1] | plus: 0 %}
      {% assign date = review_parts[2] %}
      {% assign text = review_parts[3] %}
      {% assign verified = review_parts[4] %}
      
      <div class="ai-review-card-{{ ai_gen_id }} {% if forloop.index > 6 %}ai-review-card-hidden-{{ ai_gen_id }}{% endif %}" data-review-card>
        <div class="ai-review-header-{{ ai_gen_id }}">
          <h3 class="ai-review-name-{{ ai_gen_id }}">{{ name }}</h3>
          <span class="ai-review-date-{{ ai_gen_id }}">{{ date }}</span>
        </div>
        
        <div class="ai-review-stars-{{ ai_gen_id }}">
          {% for i in (1..5) %}
            {% if i <= rating %}
              <svg class="ai-review-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% else %}
              <svg class="ai-review-star-{{ ai_gen_id }} ai-review-star-empty-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endif %}
          {% endfor %}
        </div>
        
        <p class="ai-review-text-{{ ai_gen_id }}">{{ text }}</p>
        
        {% if verified == 'true' %}
          <div class="ai-review-verified-{{ ai_gen_id }}">
            <svg class="ai-review-verified-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
            </svg>
            Verified Purchase
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <div class="ai-reviews-load-more-{{ ai_gen_id }}">
    <button class="ai-reviews-button-{{ ai_gen_id }}" data-load-more>
      {{ block.settings.button_text }}
    </button>
  </div>
</customer-reviews-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomerReviews{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.reviewsPerLoad = 6;
        this.currentlyVisible = 6;
      }

      connectedCallback() {
        this.loadMoreButton = this.querySelector('[data-load-more]');
        this.reviewCards = this.querySelectorAll('[data-review-card]');
        this.totalReviews = this.reviewCards.length;
        
        if (this.loadMoreButton) {
          this.loadMoreButton.addEventListener('click', () => this.loadMoreReviews());
        }
        
        this.updateButtonState();
      }

      loadMoreReviews() {
        const hiddenCards = Array.from(this.reviewCards).filter(card => 
          card.classList.contains('ai-review-card-hidden-{{ ai_gen_id }}')
        );
        
        const cardsToShow = hiddenCards.slice(0, this.reviewsPerLoad);
        
        cardsToShow.forEach(card => {
          card.classList.remove('ai-review-card-hidden-{{ ai_gen_id }}');
        });
        
        this.currentlyVisible += cardsToShow.length;
        this.updateButtonState();
      }

      updateButtonState() {
        if (this.currentlyVisible >= this.totalReviews) {
          this.loadMoreButton.style.display = 'none';
        } else {
          this.loadMoreButton.style.display = 'inline-block';
        }
      }
    }

    customElements.define('customer-reviews-{{ ai_gen_id }}', CustomerReviews{{ ai_gen_id }});
  })();
</script>

