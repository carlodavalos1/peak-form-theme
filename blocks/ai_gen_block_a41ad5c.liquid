      connectedCallback() {
        this.grid = this.querySelector('[data-reviews-grid]');
        this.loadMoreBtn = this.querySelector('[data-load-more]');
        
        if (this.loadMoreBtn) {
          this.loadMoreBtn.addEventListener('click', () => this.loadMoreReviews());
        }

        setTimeout(() => {
          this.animateInitialReviews();
        }, 100);
      }

      animateInitialReviews() {
        const initialCards = this.querySelectorAll('.ai-review-card-{{ ai_gen_id }}');
        initialCards.forEach((card, index) => {
          setTimeout(() => {
            card.classList.add('visible');
          }, index * 100);
        });
      }

      loadMoreReviews() {
        const nextBatch = this.allReviews.slice(this.currentIndex, this.currentIndex + this.batchSize);
        
        nextBatch.forEach((review, index) => {
          const card = this.createReviewCard(review);
          this.grid.appendChild(card);
          
          setTimeout(() => {
            card.classList.add('visible');
          }, index * 100);
        });

        this.currentIndex += this.batchSize;

        if (this.currentIndex >= this.allReviews.length) {
          this.loadMoreBtn.classList.add('hidden');
        }
      }

      createReviewCard(review) {
        const card = document.createElement('div');
        card.className = 'ai-review-card-{{ ai_gen_id }}';
        
        let starsHTML = '';
        for (let i = 1; i <= 5; i++) {
          if (i <= review.rating) {
            starsHTML += '<svg class="ai-review-star-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>';
          } else {
            starsHTML += '<svg class="ai-review-star-{{ ai_gen_id }} ai-review-star-empty-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>';
          }
        }

        card.innerHTML = `
          <div class="ai-review-header-{{ ai_gen_id }}">
            <h3 class="ai-review-name-{{ ai_gen_id }}">${review.name}</h3>
            <span class="ai-review-date-{{ ai_gen_id }}">${review.date}</span>
          </div>
          <div class="ai-review-stars-{{ ai_gen_id }}">
            ${starsHTML}
          </div>
          <p class="ai-review-text-{{ ai_gen_id }}">${review.text}</p>
        `;

        return card;
      }
    }

    customElements.define('customer-reviews-{{ ai_gen_id }}', CustomerReviews{{ ai_gen_id }});
  })();
</script>

