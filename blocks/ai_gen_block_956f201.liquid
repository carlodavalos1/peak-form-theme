{% doc %}
  @prompt
    Create a custom section block with an editable heading and subtitle at the top, followed by a horizontal carousel of customer images that auto-slides in a continuous infinite loop. Images only — no names, no stars, no review text. Images uploaded via theme editor, displayed as uniform rounded cards. No arrows or dots. Pause on hover. Responsive across devices., I need it automatically sliding, its not sliding automatically
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-customer-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-customer-carousel__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
    padding: 0 20px;
  }

  .ai-customer-carousel__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.subtitle_spacing }}px 0;
    font-weight: 700;
  }

  .ai-customer-carousel__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-customer-carousel__track-wrapper-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .ai-customer-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.image_gap }}px;
    width: max-content;
  }

  .ai-customer-carousel__track-{{ ai_gen_id }}.animated {
    animation: ai-carousel-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-customer-carousel__track-{{ ai_gen_id }}.paused {
    animation-play-state: paused;
  }

  .ai-customer-carousel__item-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_width }}px;
    height: {{ block.settings.image_height }}px;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.card_background }};
    box-shadow: 0 2px 8px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
  }

  .ai-customer-carousel__item-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-customer-carousel__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-customer-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @keyframes ai-carousel-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-customer-carousel__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-customer-carousel__subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.85);
    }

    .ai-customer-carousel__item-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_image_width }}px;
      height: {{ block.settings.mobile_image_height }}px;
    }
  }
{% endstyle %}

<customer-carousel-{{ ai_gen_id }}
  class="ai-customer-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank or block.settings.subtitle != blank %}
    <div class="ai-customer-carousel__header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-customer-carousel__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-customer-carousel__subtitle-{{ ai_gen_id }}">
          {{ block.settings.subtitle }}
        </p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-customer-carousel__track-wrapper-{{ ai_gen_id }}">
    <div class="ai-customer-carousel__track-{{ ai_gen_id }}" data-carousel-track>
      {% liquid
        assign images_array = ''
        for i in (1..12)
          assign image_key = 'image_' | append: i
          assign current_image = block.settings[image_key]
          if current_image != blank
            assign images_array = images_array | append: i | append: ','
          endif
        endfor
        assign images_count = images_array | split: ',' | size
      %}

      {% if images_count > 0 %}
        {% for iteration in (1..2) %}
          {% for i in (1..12) %}
            {% assign image_key = 'image_' | append: i %}
            {% assign current_image = block.settings[image_key] %}
            {% if current_image != blank %}
              <div class="ai-customer-carousel__item-{{ ai_gen_id }}">
                <img
                  src="{{ current_image | image_url: width: 600 }}"
                  alt="{{ current_image.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image_width }}"
                  height="{{ block.settings.image_height }}"
                >
              </div>
            {% endif %}
          {% endfor %}
        {% endfor %}
      {% else %}
        {% for iteration in (1..2) %}
          {% for i in (1..8) %}
            <div class="ai-customer-carousel__item-{{ ai_gen_id }}">
              <div class="ai-customer-carousel__placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            </div>
          {% endfor %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</customer-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomerCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = null;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-carousel-track]');
        if (!this.track) return;

        setTimeout(() => {
          this.track.classList.add('animated');
        }, 100);

        this.track.addEventListener('mouseenter', () => {
          this.track.classList.add('paused');
        });

        this.track.addEventListener('mouseleave', () => {
          this.track.classList.remove('paused');
        });

        this.track.addEventListener('touchstart', () => {
          this.track.classList.add('paused');
        });

        this.track.addEventListener('touchend', () => {
          setTimeout(() => {
            this.track.classList.remove('paused');
          }, 300);
        });
      }
    }

    customElements.define('customer-carousel-{{ ai_gen_id }}', CustomerCarousel{{ ai_gen_id }});
  })();
</script>

