{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-how-it-works-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
  }

  .ai-how-it-works-content-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-how-it-works-headings-{{ ai_gen_id }} {
    margin-bottom: 12px;
    line-height: 0.7;
  }

  .ai-how-it-works-top-heading-{{ ai_gen_id }} {
    margin: 0 0 -50px 0;
    color: {{ block.settings.top_heading_color }};
    line-height: 0.7;
  }

  .ai-how-it-works-bottom-heading-{{ ai_gen_id }} {
    margin: 0;
    line-height: 0.7;
  }

  .ai-how-it-works-bottom-heading-{{ ai_gen_id }} .accent-text {
    background: {{ block.settings.gradient_color }};
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: inline-block;
  }

  .ai-how-it-works-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin: 0;
  }

  .ai-how-it-works-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-how-it-works-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    aspect-ratio: 1694 / 2528;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-how-it-works-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 450px;
  }

  .ai-how-it-works-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-how-it-works-top-heading-{{ ai_gen_id }} {
      margin: 0 0 -35px 0;
    }
  }
{% endstyle %}

<div class="ai-how-it-works-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-how-it-works-content-{{ ai_gen_id }}">
    <div class="ai-how-it-works-headings-{{ ai_gen_id }}">
      {% if block.settings.top_heading != blank %}
        <h2 class="ai-how-it-works-top-heading-{{ ai_gen_id }} h1">
          {{ block.settings.top_heading }}
        </h2>
      {% endif %}

      {% if block.settings.bottom_heading != blank %}
        <h2 class="ai-how-it-works-bottom-heading-{{ ai_gen_id }} h1">
          <span class="accent-text">{{ block.settings.bottom_heading }}</span>
        </h2>
      {% endif %}
    </div>

    <div class="ai-how-it-works-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 2000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-how-it-works-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-how-it-works-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-how-it-works-empty-state-{{ ai_gen_id }}">
            Add your "How it works" image
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "How it works",
  "settings": [
    {
      "type": "header",
      "content": "Top heading"
    },
    {
      "type": "richtext",
      "id": "top_heading",
      "label": "Top heading",
      "default": "<p>How does</p>"
    },
    {
      "type": "color",
      "id": "top_heading_color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Bottom heading (glowy)"
    },
    {
      "type": "richtext",
      "id": "bottom_heading",
      "label": "Bottom heading",
      "default": "<p>it work?</p>"
    },
    {
      "type": "color_background",
      "id": "gradient_color",
      "label": "Gradient",
      "default": "linear-gradient(91deg, rgba(23, 67, 60, 1), rgba(42, 107, 95, 1) 50%, rgba(61, 148, 136, 1) 100%)"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "How it works"
    }
  ]
}
{% endschema %}
