{%- comment -%} Usage: render 'pf-md-icon', name: 'check' {%- endcomment -%}
{%- capture a -%}xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"{%- endcapture -%}
{%- case name -%}
  {%- when 'check' -%}<svg {{ a }} stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
  {%- when 'check-circle' -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'x' -%}<svg {{ a }} stroke-width="3"><path d="M18 6L6 18M6 6l12 12"/></svg>
  {%- when 'left' -%}<svg {{ a }}><path d="M15 18l-6-6 6-6"/></svg>
  {%- when 'right' -%}<svg {{ a }}><path d="M9 18l6-6-6-6"/></svg>
  {%- when 'chevron' -%}<svg {{ a }}><path d="M6 9l6 6 6-6"/></svg>
  {%- when 'play' -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 3.5v17l14-8.5z"/></svg>
  {%- when 'shield' -%}<svg {{ a }}><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
  {%- when 'truck' -%}<svg {{ a }}><path d="M1 3h15v13H1zM16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
  {%- when 'refresh' -%}<svg {{ a }}><path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.5 9a9 9 0 0114.9-3.4L23 10M1 14l4.6 4.4A9 9 0 0020.5 15"/></svg>
  {%- when 'leaf' -%}<svg {{ a }}><path d="M11 20A7 7 0 019.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10z"/><path d="M2 21c0-3 1.9-5.4 5.1-6C9.5 14.5 12 13 13 12"/></svg>
  {%- when 'eye' -%}<svg {{ a }}><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
  {%- when 'drop' -%}<svg {{ a }}><path d="M12 2.7l5.7 5.6a8 8 0 11-11.3 0z"/></svg>
  {%- when 'flask' -%}<svg {{ a }}><path d="M9 3h6M10 3v6L4.5 18.5A2 2 0 006.3 21h11.4a2 2 0 001.8-2.5L14 9V3"/><path d="M7 15h10"/></svg>
  {%- when 'globe' -%}<svg {{ a }}><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 010 20M12 2a15 15 0 000 20"/></svg>
  {%- when 'lock' -%}<svg {{ a }}><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
  {%- when 'award' -%}<svg {{ a }}><circle cx="12" cy="8" r="6"/><path d="M15.5 13.5L17 22l-5-3-5 3 1.5-8.5"/></svg>
  {%- when 'sun' -%}<svg {{ a }}><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  {%- when 'moon' -%}<svg {{ a }}><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
  {%- when 'heart' -%}<svg {{ a }}><path d="M20.8 4.6a5.5 5.5 0 00-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 00-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 000-7.8z"/></svg>
  {%- when 'clock' -%}<svg {{ a }}><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
  {%- when 'sparkle' -%}<svg {{ a }}><path d="M12 3l1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2z"/></svg>
  {%- when 'monitor' -%}<svg {{ a }}><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
  {%- when 'book' -%}<svg {{ a }}><path d="M2 4h7a3 3 0 013 3v14a2 2 0 00-2-2H2zM22 4h-7a3 3 0 00-3 3v14a2 2 0 012-2h8z"/></svg>
  {%- when 'car' -%}<svg {{ a }}><path d="M5 17h14M3 13l2-6h14l2 6v5H3z"/><circle cx="7.5" cy="15.5" r="1"/><circle cx="16.5" cy="15.5" r="1"/></svg>
  {%- when 'zap' -%}<svg {{ a }}><path d="M13 2L3 14h9l-1 8 10-12h-9z"/></svg>
  {%- when 'warning' -%}<svg {{ a }}><path d="M10.3 3.9L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z"/><path d="M12 9v4M12 17h.01"/></svg>
  {%- when 'verified' -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 1l2.6 2 3.3-.2.9 3.2 2.8 1.8-1.2 3.1 1.2 3.1-2.8 1.8-.9 3.2-3.3-.2L12 23l-2.6-2-3.3.2-.9-3.2-2.8-1.8 1.2-3.1L2.4 10l2.8-1.8.9-3.2 3.3.2z"/><path d="M8 12.2l2.6 2.6L16 9.4" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'japan' -%}<svg {{ a }}><rect x="2" y="5" width="20" height="14" rx="2"/><circle cx="12" cy="12" r="3.5" fill="currentColor" stroke="none"/></svg>
  {%- when 'gmp' -%}<svg {{ a }}><path d="M12 2l3 2.2 3.7-.1 1.1 3.5 3 2.2-1.2 3.5 1.2 3.5-3 2.2-1.1 3.5-3.7-.1L12 24l-3-2.2-3.7.1-1.1-3.5-3-2.2 1.2-3.5L1.2 9.3l3-2.2 1.1-3.5 3.7.1z" transform="scale(.92) translate(1 0)"/><path d="M8.5 12l2.5 2.5 4.5-4.5"/></svg>
  {%- when 'dropper' -%}<svg {{ a }}><rect x="9.5" y="2" width="5" height="4" rx="2"/><path d="M8 6h8M10 6v2.5L9.5 9v6.5L12 19l2.5-3.5V9L14 8.5V6"/><path d="M12 21.5v.01"/></svg>
  {%- when 'mouth' -%}<svg {{ a }}><path d="M2 11c3-3.5 6.5-4 10-2 3.5-2 7-1.5 10 2-2.5 4.5-6 7-10 7s-7.5-2.5-10-7z"/><path d="M3 11h18"/><path d="M9 11v1.5a3 3 0 006 0V11"/></svg>
  {%- when 'stethoscope' -%}<svg {{ a }}><path d="M6 3H4.5v6a4.5 4.5 0 009 0V3H12"/><path d="M9 13.5V15a5 5 0 0010 0v-2.5"/><circle cx="19" cy="10.5" r="2"/></svg>
  {%- when 'calendar' -%}<svg {{ a }}><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
  {%- when 'guarantee' -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 160" aria-hidden="true"><circle cx="80" cy="80" r="76" fill="#1E2F63"/><circle cx="80" cy="80" r="66" fill="none" stroke="#E6C77F" stroke-width="2"/><text x="80" y="58" text-anchor="middle" font-family="Poppins,Arial,sans-serif" font-size="11" fill="#E6C77F" letter-spacing="3">&#9733; &#9733; &#9733;</text><text x="80" y="96" text-anchor="middle" font-family="Poppins,Arial,sans-serif" font-size="44" font-weight="700" fill="#fff">{{ days | default: 60 }}</text><text x="80" y="114" text-anchor="middle" font-family="Poppins,Arial,sans-serif" font-size="10" font-weight="600" fill="#E6C77F" letter-spacing="1.5">DAY MONEY-BACK</text><text x="80" y="127" text-anchor="middle" font-family="Poppins,Arial,sans-serif" font-size="10" font-weight="600" fill="#E6C77F" letter-spacing="1.5">GUARANTEE</text></svg>
  {%- else -%}<svg {{ a }}><circle cx="12" cy="12" r="9"/><path d="M8.5 12l2.5 2.5 4.5-4.5"/></svg>
{%- endcase -%}
