    "pf_faq": {
      "type": "pf-md-faq",
      "blocks": {
        "q1": {
          "type": "q",
          "settings": {
            "q": "Can I buy Heart Ritual in stores?",
            "a": "<p>No. Heart Ritual is only sold on our website. We don’t sell on Amazon, eBay or in stores, so you always get it fresh and straight from us.</p>"
          }
        },
        "q2": {
          "type": "q",
          "settings": {
            "q": "What ingredients are in Heart Ritual?",
            "a": "<p>Five: beetroot, aged odorless garlic, nattokinase, CoQ10 and vitamin K2. The exact amount of each is on the Supplement Facts panel on the pouch.</p>"
          }
        },
        "q3": {
          "type": "q",
          "settings": {
            "q": "Is Heart Ritual safe to take with my current medications?",
            "a": "<p>Heart Ritual is a dietary supplement and doesn’t replace any medication. Nattokinase, garlic and vitamin K2 can interact with blood thinners such as warfarin or aspirin, and with blood pressure medication. If you take any medication or have surgery coming up, talk to your doctor before you start.</p>"
          }
        },
        "q4": {
          "type": "q",
          "settings": {
            "q": "How should I store Heart Ritual?",
            "a": "<p>Keep the pouch sealed in a cool, dry place away from direct sunlight, and press the zip closed after each use.</p>"
          }
        },
        "q5": {
          "type": "q",
          "settings": {
            "q": "Will Heart Ritual help with my cardiovascular wellness and energy levels?",
            "a": "<p>Heart Ritual is designed to support healthy circulation, heart health and cellular energy. Beetroot supports nitric oxide, garlic and nattokinase support healthy blood flow, CoQ10 fuels heart cells and vitamin K2 helps direct calcium to your bones.*</p>"
          }
        },
        "q6": {
          "type": "q",
          "settings": {
            "q": "How long until I notice a difference?",
            "a": "<p>Everyone is different. Ingredients like CoQ10 build up over weeks, so give it at least 60 days of daily use. That’s why our guarantee is 60 days.*</p>"
          }
        },
        "q7": {
          "type": "q",
          "settings": {
            "q": "How often should I take the supplement?",
            "a": "<p>Every day. Take 2 capsules with water, ideally with breakfast.</p>"
          }
        },
        "q8": {
          "type": "q",
          "settings": {
            "q": "How many servings are in each pouch?",
            "a": "<p>Each pouch holds 60 capsules, which is 30 servings or a one-month supply.</p>"
          }
        },
        "q9": {
          "type": "q",
          "settings": {
            "q": "What is Peak Form?",
            "a": "<p>Peak Form makes simple, third-party tested supplements for adults who want to stay active in the second half of life.</p>"
          }
        },
        "q10": {
          "type": "q",
          "settings": {
            "q": "Are there any age or health restrictions?",
            "a": "<p>Heart Ritual is intended for healthy adults 18 and over. It is not for anyone who is pregnant or nursing. Nattokinase comes from soybeans, so skip it if you have a soy allergy. If you have a medical condition or take medication, talk to your doctor before use.</p>"
          }
        },
        "q11": {
          "type": "q",
          "settings": {
            "q": "What if it isn’t for me?",
            "a": "<p>You’re covered by our 60-day money-back guarantee. Contact our team for a full refund.</p>"
          }
        }
      },
